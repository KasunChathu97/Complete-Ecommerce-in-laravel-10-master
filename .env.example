APP_NAME="Delimach Lanka (Pvt) Ltd"
APP_ENV=local
APP_KEY=base64:3KqwxfD0phx6FeWtx6BNKbx6tzexzcq+UDJZ6+UA50M=
APP_DEBUG=true

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eshop_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=artspirograph79@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=artspirograph79@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional: seed demo data from the included phpMyAdmin dump
# When true, `php artisan db:seed` will import INSERT statements from the SQL file.
IMPORT_ESHOP_SQL_SEED=false
# Override if your SQL dump is in a different location.
ESHOP_SQL_SEED_PATH=

# SMS
# When a new row is inserted into `sms_logs`, the app can send SMS + (optionally) email.
SMS_ENABLED=false
SMS_EMAIL_ENABLED=true
# Provider key: twilio | textit (aliases supported: textit.biz, textit_biz)
SMS_PROVIDER=twilio
SMS_DEFAULT_COUNTRY_CODE=+94

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SMS (Textit.biz)
TEXTIT_BASE_URL=https://api.textit.biz/
TEXTIT_API_VERSION=v1
# Full Authorization header value (as provided by Textit), including the "Basic " prefix.
# Example: TEXTIT_AUTHORIZATION="Basic ABCDEFGHIJKLKMNOPQRSTUV"
TEXTIT_AUTHORIZATION=
TEXTIT_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
